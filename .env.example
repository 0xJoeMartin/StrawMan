# Scarecrow API Keys
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Required: Anthropic API key (for Claude vision + dialogue generation)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: ElevenLabs API key (for premium spooky voice)
# Without this, the system falls back to Piper (local) or espeak
ELEVENLABS_API_KEY=your-key-here

# Optional: ElevenLabs voice ID
# Browse voices at https://elevenlabs.io/voice-library
# Good spooky options: search for "dark", "sinister", "narrator"
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
